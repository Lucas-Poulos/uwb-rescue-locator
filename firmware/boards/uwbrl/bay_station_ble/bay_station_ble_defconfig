CONFIG_GPIO=y
CONFIG_SERIAL=y
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

# nRESET pad is RESET_BLE_N, driven by the nRF9151 and the BT840 SWD header.
CONFIG_GPIO_AS_PINRESET=y

# Whether the BT840 carries a 32.768 kHz crystal is not yet confirmed from
# the Fanstel datasheet. RC is the safe default (it always works); switch to
# the crystal source once confirmed, for lower BLE sleep current.
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y
