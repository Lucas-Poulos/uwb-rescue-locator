				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "aa97f18a-851b-4be0-a631-99040d48fe4b")
	)
	(text "Generic M3-clearance mounting holes (Mechanical:MountingHole, no\nelectrical connection), placeholder positions only. Anchor placement\nand enclosure geometry are still an open decision -- see\ndocs/decisions.md, 'Anchor placement / enclosure for the bay\nstation's 4 UWB anchors'. Final hole positions depend on that\ndecision plus the enclosure/PCB outline, neither finalized yet."
		(exclude_from_sim no)
		(at 101.092 62.484 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c9626f39-ccad-4a2f-bf56-4e7c9c47512d")
	)
