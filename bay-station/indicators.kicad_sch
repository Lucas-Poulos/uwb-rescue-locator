				)
			)
		)
		(property "Description" "D4 series R. +VSYS (MCP73871 OUT) -> R -> LED -> STAT1 (open-drain, sink). I = (VSYS - VF - VOL)/R = (5.0-1.8-0.2)/1.5k = 2.0mA on adapter; (3.6-1.8-0.2)/1.5k = 1.1mA on battery. Rail is +VSYS, not +3V3, to stay inside the \"-0.3V to VDD+0.3V\" pin abs-max (VDD = VIN or VBAT) at low battery."
			(at 69.85 64.77 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
