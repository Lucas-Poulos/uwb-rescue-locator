			(uuid "afd36c2e-1549-441f-ba98-a02dbc1b90b5")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Description" "I2C SDA Pull-up for the shared I2C bus (nRF9151 host; MAX17048 0x36, IIS2MDC 0x1E, IIS2DLPC 0x18/0x19). 3.3k: Rp(min) = (3.3-0.4)/IOL = 2.9k for the nRF9151 standard-drive IOL,SD min 1 mA (nRF9151 PS GPIO electrical spec), so 2.2k (sized for the nRF52840) would need high-drive pins. tr = 0.8473*Rp*Cb (NXP UM10204) allows ~107 pF at 400 kHz. MUST pull up to +3V3, never to VBATT_PROT (MAX17048 VDD reaches 4.2 V; nRF9151 VDD_GPIO max 3.6 V)."
			(at 0 0 90)
			(layer "F.Fab")
			(hide yes)
			(uuid "45cff9ff-1d8b-4243-a92f-0af4dafe05bc")
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
