			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Description" "Series resistor between every reset source (J3 pin 10, J34 pin 3, SW2) and the nRF9151 nRESET. Nordic nRF9151 HDG 'nRESET': 13 kOhm internal pull-up to an internal 2.2 V, 'External pull-up is not allowed', and 'It is recommended to add a bypass capacitor and series resistor in the range of 1 kOhm'. The nRESET circuit example adds that the resistor limits leakage from a 3.3 V tool into the 2.2 V domain (ESD diode conducts from ~2.8 V) and the pin must still fall below 0.66 V: 2.2 V x 1k/14k = 0.16 V. The bypass capacitor belongs AT the nRF9151 pin (connectivity.kicad_sch), not here."
			(at 114.3 129.54 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
