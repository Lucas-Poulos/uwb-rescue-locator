			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "Description" "BT840 (nRF52840) SWD: standard ARM Cortex 10-pin 1.27 mm header, same pinout as J3 (Tag-Connect TC2030-CTX datasheet Cortex column). VTref = +3V3 (BT840 VDD). nRESET -> RESET_BLE_N directly: the nRF52840 reset pin is P0.18 with an on-chip pull-up and needs no series part, BUT it only acts as reset once UICR.PSELRESET is programmed (Zephyr CONFIG_GPIO_AS_PINRESET) -- not re-verified against the nRF52840 PS here (Nordic PDF blocked)."
			(at 190.5 144.78 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
