(version 1)

# bay-station custom rules.  GENERATED by scripts/layout/apply_rules.py from
# scripts/layout/hs_nets.json -- edit there, not here.
#
# Every rule below is CONDITIONED.  An unconditioned clearance rule would
# override every netclass clearance (kicad-pcbnew-headless-gotchas).
# The RF50/CLK netclass clearance stays 0.15 mm because the DW3210 pad
# pitch (0.4 mm, 0.25 mm pads) leaves exactly 0.15 mm; the wider keep-off
# applies only track/via/zone-to-track/via/zone, never pad-to-pad.

(rule "RF50 keep-off (track/via/zone to foreign track/via/zone)"
	(condition "A.NetClass == 'RF50' && A.Type != 'Pad' && B.NetClass != 'RF50' && (B.Type == 'Track' || B.Type == 'Via' || B.Type == 'Zone')")
	(constraint clearance (min 0.50mm))
)

(rule "RF50 width window (neck at the pad .. 0.5 mm)"
	(condition "A.NetClass == 'RF50' && A.Type == 'Track'")
	(constraint track_width (min 0.20mm) (max 0.50mm))
)

(rule "RF50 carries no vias"
	(condition "A.NetClass == 'RF50' && A.Type == 'Via'")
	(constraint disallow via)
)

(rule "CLK keep-off from other tracks/vias/zones"
	(condition "A.NetClass == 'CLK' && A.Type == 'Track' && B.NetClass != 'CLK' && (B.Type == 'Track' || B.Type == 'Via' || B.Type == 'Zone')")
	(constraint clearance (min 0.50mm))
)

# GND pad tie stub next to an RF50/CLK pad neck (scripts/layout/stitch.py --rescue, route_hs_uwb.py ties).
# The RF-side VSS pins of a DW3210 (and the GND pins beside an RF pin of a fine-pitch LGA/TSNP) sit
# 0.15-0.4 mm from the RF pad, and the 0.24 mm pad neck runs straight out between them, so a GND stub
# leaving such a pad is inside the 0.5 mm keep-off by construction.  Relaxed to the netclass 0.15 mm ONLY
# for a GND TRACK (never a via, never a pour) that touches a tie rule area: DW3210_TIE_n (cut-out + 2 mm
# per side) or HS_TIE_k (3 mm square around the RF pin).  Both areas forbid nothing.  Must stay LAST:
# KiCad lets the later matching rule win.

(rule "GND pad tie stub next to an RF50 neck (tie areas only)"
	(condition "(A.NetClass == 'RF50' || A.NetClass == 'CLK') && A.Type == 'Track' && B.NetName == 'GND' && B.Type == 'Track' && (B.intersectsArea('DW3210_TIE_*') || B.intersectsArea('HS_TIE_*'))")
	(constraint clearance (min 0.15mm))
)
