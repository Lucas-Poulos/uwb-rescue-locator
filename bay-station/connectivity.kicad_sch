		)
		(property "Description" "I2C SDA Pull-up for the shared I2C bus (nRF9151 host; MAX17048 0x36, LIS3MDL 0x1C/0x1E, LIS2DH 0x18/0x19). 3.3k: Rp(min) = (3.3-0.4)/IOL = 2.9k for the nRF9151 standard-drive IOL,SD min 1 mA (nRF9151 PS GPIO electrical spec), so 2.2k (sized for the nRF52840) would need high-drive pins. tr = 0.8473*Rp*Cb (NXP UM10204) allows ~107 pF at 400 kHz. MUST pull up to +3V3, never to VBATT_PROT (MAX17048 VDD reaches 4.2 V; nRF9151 VDD_GPIO max 3.6 V)."
			(at 431.8 177.8 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
