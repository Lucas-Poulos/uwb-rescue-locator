	(footprint "Resistor_SMD:R_0603_1608Metric"
		(layer "F.Cu")
		(uuid "9c6b38df-df5c-4143-85d0-9d660cbb5a11")
		(at 117.5 90.5)
		(descr "Resistor SMD 0603 (1608 Metric), square (rectangular) end terminal, IPC-7351 nominal, (Body size source: IPC-SM-782 page 72, https://www.pcb-3d.com/wordpress/wp-content/uploads/ipc-sm-782a_amendment_1_and_2.pdf)")
		(tags "resistor")
		(property "Reference" "R12"
			(at 0 -1.43 0)
			(layer "F.SilkS")
			(uuid "4895e19f-651d-41f8-ad8d-969aa03f750b")
			(effects
