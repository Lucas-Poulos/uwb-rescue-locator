		(property "Footprint" "Crystal:Crystal_SMD_3215-2Pin_3.2x1.5mm"
			(at 63.5 220.98 0)
			(effects
				(font
					(size 1.27 1.27)
				)
				(hide yes)
			)
		)
		(property "Datasheet" "https://content.u-blox.com/sites/default/files/NINA-B40_DataSheet_UBX-19049405.pdf"
			(at 63.5 220.98 0)
			(effects
				(font
					(size 1.27 1.27)
				)
				(hide yes)
			)
		)
		(property "Description" "Epson FC-135 32.768kHz LFXO crystal for NINA-B400 (U3) pins 2/3 XL1/XL2. Meets every line of the NINA-B40 data sheet UBX-19049405 R09 Table 14 '32.768 kHz crystal (LFXO)': 32.768kHz nominal, +/-20ppm vs the +/-500ppm max allowed for Bluetooth LE, CL 12.5pF vs 12.5pF max, ESR 70k vs 100k max. REQUIRED FOR LOW SLEEP CURRENT -- NINA-B4 system integration manual UBX-19052230 R13 section 1.9: 'To reach the lowest sleep current consumption of the NINA-B4 module, an external crystal or external clock source shall be used. The internal oscillator gives higher sleep current.' LCSC C32346."
			(at 63.5 220.98 0)
			(effects
				(font
					(size 1.27 1.27)
				)
				(hide yes)
			)
		)
		(property "MPN" "Q13FC13500004"
			(at 63.5 220.98 0)
			(effects
