				)
			)
			(property "Description" "Qorvo/Decawave DWM3000 UWB transceiver module, IEEE 802.15.4-2015 and IEEE 802.15.4z BPRF compliant, based on the Qorvo DW3110 IC, 24-pin 1.4mm-pitch side-castellated package 23x13x2.9mm, no onboard host MCU (matches this design, which uses a separate NINA-B111 BLE MCU as the SPI host). Confirmed choice over DWM3001C (which integrates its own nRF52833 BLE MCU + antenna + accelerometer -- would be redundant with NINA-B111 here). All pin/electrical data verified directly against the real Qorvo DWM3000 Data Sheet Rev B, May 2021 (Table 2 'DWM3000 Pin Functions' and Figure 8 'DWM3000 Pin Diagram')."
				(at 0 0 0)
				(effects
					(font
						(size 1.27 1.27)
					)
					(hide yes)
				)
			)
