	(text "Replaced MCP1700T-3302E/TT 2026-09-23: IQ 1.6uA -> 25nA typ,"
		(exclude_from_sim no)
		(at 101.6 77.47 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "04c5f6c1-a802-4cf7-991c-2fe3ce58de14")
	)
	(text "which was the board's largest standby draw. 200mA, 45mA used."
		(exclude_from_sim no)
		(at 101.6 82.55 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9faea6ab-c5f5-4ee4-b5b6-cfa4b9c39f85")
	)
	(text "EN is tied to VBAT, not to a GPIO: TPS7A02 is DISABLED when EN"
		(exclude_from_sim no)
		(at 101.6 107.95 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6c61b35f-9e54-4b00-a6d8-1dae80945280")
	)
	(text "floats (internal pulldown, SBVS277C Table 5-1), and the MCU this"
		(exclude_from_sim no)
		(at 101.6 113.03 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4874150d-98e5-402f-b558-4bc722b5681e")
	)
	(text "rail powers cannot enable its own supply."
		(exclude_from_sim no)
		(at 101.6 118.11 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0fd25bd0-bb8f-4bfd-91ab-3618978f9ba4")
	)
	(text "C12 is 2.2uF, not 1uF: SBVS277C s6.3 needs >=0.5uF EFFECTIVE"
